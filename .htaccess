# Apache (hosting współdzielony). Wymaga mod_rewrite, mod_headers, mod_deflate, mod_expires.
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wymuszenie HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Wersja kanoniczna bez "index.html"
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [L,R=301]

  # Opcjonalnie: wymuszenie "www" (odkomentuj i podmień domenę)
  # RewriteCond %{HTTP_HOST} ^example\.pl$ [NC]
  # RewriteRule ^ https://www.example.pl%{REQUEST_URI} [L,R=301]
</IfModule>

# Blokada plików ukrytych i konfiguracyjnych
<FilesMatch "^\.|\.(md|log|bak|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HSTS: włącz dopiero po sprawdzeniu, że HTTPS działa poprawnie na całej domenie
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Jeśli dodasz GA4, rozszerz script-src o https://www.googletagmanager.com, a connect-src/img-src o https://*.google-analytics.com
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://images.unsplash.com; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/ld+json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
